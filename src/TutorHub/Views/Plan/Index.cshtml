@model Tenant
@{
    ViewData["Title"] = "Робочий простір";
}

<h1 class="h3 mb-3">@Model.Name</h1>

@if (User.IsInRole(TenantRoles.Owner))
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Запрошення учасників</h2>
            <p>Передайте цей код помічнику або іншому репетитору для реєстрації: <code>@Model.MemberInviteCode</code></p>
            <p class="text-muted">Учні реєструються за окремим кодом, який можна створити на сторінці учня.</p>
            <form asp-action="RegenerateInvite" method="post">
                <button type="submit" class="btn btn-outline-primary btn-sm">Створити новий код</button>
            </form>
        </div>
    </div>
}
