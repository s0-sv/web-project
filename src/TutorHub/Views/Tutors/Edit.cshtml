@model Tutor
@{
    ViewData["Title"] = "Редагування репетитора";
}

<h1 class="h3 mb-3">Редагування репетитора</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-6">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Скасувати</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
