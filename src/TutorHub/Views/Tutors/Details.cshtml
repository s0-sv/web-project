@model Tutor
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.FullName</h1>
    <div class="text-nowrap">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Видалити</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Телефон</dt>
    <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
    <dt class="col-sm-3">Ставка</dt>
    <dd class="col-sm-9">@Model.HourlyRate.ToString("0.##") грн/год</dd>
    <dt class="col-sm-3">Про репетитора</dt>
    <dd class="col-sm-9">@(Model.Bio ?? "—")</dd>
</dl>

<h2 class="h5">Заняття</h2>
<partial name="_LessonsTable" model="Model.Lessons.OrderByDescending(l => l.StartsAt)" />

<a asp-action="Index">До списку репетиторів</a>
