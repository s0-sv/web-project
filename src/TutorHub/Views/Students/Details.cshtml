@model Student
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.FullName</h1>
    <div class="text-nowrap">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Видалити</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Телефон</dt>
    <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
    <dt class="col-sm-3">Навчальна мета</dt>
    <dd class="col-sm-9">@(Model.LearningGoal ?? "—")</dd>
    <dt class="col-sm-3">Telegram</dt>
    <dd class="col-sm-9">@(Model.TelegramChatId is null ? "не підключено" : "підключено")</dd>
</dl>

@if (User.IsInRole(TenantRoles.Owner))
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6">Доступ учня</h2>
            @if (Model.InviteCode is not null)
            {
                <p class="mb-2">Код запрошення для реєстрації: <code>@Model.InviteCode</code></p>
            }
            <form asp-action="Invite" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-primary btn-sm">Створити новий код</button>
            </form>
        </div>
    </div>
}

<h2 class="h5">Заняття</h2>
<partial name="_LessonsTable" model="Model.Lessons.OrderByDescending(l => l.StartsAt)" />

<a asp-action="Index">До списку учнів</a>
