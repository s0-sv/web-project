@model int
@{
    ViewData["Title"] = Model == 404 ? "Сторінку не знайдено" : $"Помилка {Model}";
}

<h1>@ViewData["Title"]</h1>
<p>
    @(Model == 404
        ? "Такої сторінки чи запису не існує. Можливо, запис уже видалено."
        : "Сервер не зміг обробити запит. Перевірте дані й спробуйте ще раз.")
</p>
<a asp-controller="Home" asp-action="Index">На головну</a>
