@model List<Lesson>
@{
    ViewData["Title"] = "Головна";
    var stats = new (string Label, int Count, string Controller)[]
    {
        ("Заняття", (int)ViewBag.LessonCount, "Lessons"),
        ("Репетитори", (int)ViewBag.TutorCount, "Tutors"),
        ("Учні", (int)ViewBag.StudentCount, "Students"),
        ("Предмети", (int)ViewBag.SubjectCount, "Subjects")
    };
}

<h1 class="h3">Індивідуальне дистанційне навчання</h1>
<p class="text-muted">Розклад занять, учні, репетитори та навчальні матеріали в одному місці.</p>

<div class="row g-3 mb-4">
    @foreach (var stat in stats)
    {
        <div class="col-6 col-md-3">
            <a class="card text-decoration-none text-reset h-100" asp-controller="@stat.Controller" asp-action="Index">
                <div class="card-body">
                    <div class="h3 mb-0">@stat.Count</div>
                    <div class="text-muted">@stat.Label</div>
                </div>
            </a>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Найближчі заняття</h2>
    <a class="btn btn-primary btn-sm" asp-controller="Lessons" asp-action="Create">Запланувати заняття</a>
</div>
<partial name="_LessonsTable" model="Model" />
