@using System.Text.Json
@using TutorHub.Controllers
@inject IConfiguration Configuration
@model TutorProfilePage
@{
    Layout = null;
    var tutor = Model.Tutor;
    var headline = tutor.Headline ?? "Індивідуальні онлайн-заняття";
    var initials = string.Concat(tutor.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
    var subjectNames = string.Join(", ", Model.Subjects.Select(s => s.Name));
    var baseUrl = SeoController.BaseUrl(Configuration, Context.Request);
    var canonical = $"{baseUrl}/tutor/{tutor.Slug}";
    var pageTitle = $"{tutor.FullName}: {headline} | TutorHub";
    var fullDescription = subjectNames.Length > 0
        ? $"{tutor.FullName}: {headline}. Предмети: {subjectNames}. Індивідуальні онлайн-заняття, {tutor.HourlyRate:0.##} грн/год."
        : $"{tutor.FullName}: {headline}. Індивідуальні онлайн-заняття, {tutor.HourlyRate:0.##} грн/год.";
    var description = fullDescription.Length <= 160 ? fullDescription : $"{fullDescription[..157].TrimEnd()}...";
    var imageUrl = Model.PhotoUrl is null
        ? null
        : Model.PhotoUrl.StartsWith('/') ? $"{baseUrl}{Model.PhotoUrl}" : Model.PhotoUrl;
    var structuredData = JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = tutor.FullName,
        ["jobTitle"] = "Репетитор",
        ["description"] = tutor.Bio ?? headline,
        ["url"] = canonical,
        ["email"] = tutor.Email,
        ["telephone"] = tutor.Phone,
        ["image"] = imageUrl,
        ["knowsAbout"] = Model.Subjects.Select(s => s.Name).ToArray(),
        ["worksFor"] = new Dictionary<string, string> { ["@type"] = "Organization", ["name"] = Model.TenantName }
    }.Where(p => p.Value is not null).ToDictionary());
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@canonical" />
    <link rel="icon" href="~/favicon.ico" />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="TutorHub" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    @if (imageUrl is not null)
    {
        <meta property="og:image" content="@imageUrl" />
    }
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json">@Html.Raw(structuredData)</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-bs-spy="scroll" data-bs-target="#profile-nav" data-bs-offset="80" tabindex="0">
    <nav class="navbar navbar-expand-md bg-white border-bottom sticky-top" aria-label="Навігація сторінкою">
        <div class="container">
            <span class="navbar-brand fw-semibold">@tutor.FullName</span>
            <div class="d-flex gap-2 order-md-2 ms-auto">
                @if (tutor.Phone is not null)
                {
                    <a class="btn btn-primary btn-sm" href="tel:@tutor.Phone">Зателефонувати</a>
                }
                <a class="btn btn-outline-primary btn-sm" href="mailto:@tutor.Email">Написати</a>
            </div>
            <button class="navbar-toggler ms-2 order-md-3" type="button" data-bs-toggle="collapse" data-bs-target="#profile-nav"
                    aria-controls="profile-nav" aria-expanded="false" aria-label="Показати розділи">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse order-md-1" id="profile-nav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="#about">Про репетитора</a></li>
                    <li class="nav-item"><a class="nav-link" href="#subjects">Предмети</a></li>
                    <li class="nav-item"><a class="nav-link" href="#how">Як проходять заняття</a></li>
                    <li class="nav-item"><a class="nav-link" href="#price">Вартість</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contacts">Контакти</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        <header class="bg-body-tertiary py-5">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-md-4 text-center">
                        @if (Model.PhotoUrl is not null)
                        {
                            <img src="@Model.PhotoUrl" alt="Фото: @tutor.FullName" width="280" height="280" class="rounded-circle img-fluid profile-photo" />
                        }
                        else
                        {
                            <div class="profile-placeholder rounded-circle mx-auto" role="img" aria-label="@tutor.FullName">@initials</div>
                        }
                    </div>
                    <div class="col-md-8">
                        <h1 class="display-5">@tutor.FullName</h1>
                        <p class="lead">@headline</p>
                        <p class="text-body-secondary">Робочий простір: @Model.TenantName</p>
                        <a class="btn btn-primary btn-lg" href="#contacts">Записатися на заняття</a>
                    </div>
                </div>
            </div>
        </header>

        <section id="about" class="py-5">
            <div class="container">
                <h2 class="mb-3">Про репетитора</h2>
                <p class="lead">@(tutor.Bio ?? "Репетитор проводить індивідуальні заняття онлайн.")</p>
                @if (Model.CompletedLessons > 0)
                {
                    <p>Проведених занять у TutorHub: <strong>@Model.CompletedLessons</strong></p>
                }
            </div>
        </section>

        <section id="subjects" class="py-5 bg-body-tertiary">
            <div class="container">
                <h2 class="mb-4">Предмети</h2>
                @if (Model.Subjects.Count == 0)
                {
                    <p>Перелік предметів уточнюйте в репетитора.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var subject in Model.Subjects)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h3 class="h5 card-title">@subject.Name</h3>
                                        <p class="card-text">@subject.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section id="how" class="py-5">
            <div class="container">
                <h2 class="mb-4">Як проходять заняття</h2>
                <div class="row g-4">
                    <div class="col-md-4">
                        <h3 class="h5">1. Знайомство</h3>
                        <p>Обговорюєте мету навчання, поточний рівень і зручний розклад.</p>
                    </div>
                    <div class="col-md-4">
                        <h3 class="h5">2. Онлайн-заняття</h3>
                        <p>Заняття проходять індивідуально в онлайн-кімнаті за посиланням із розкладу.</p>
                    </div>
                    <div class="col-md-4">
                        <h3 class="h5">3. Матеріали й прогрес</h3>
                        <p>Конспекти та домашні завдання зберігаються в особистому кабінеті учня.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="price" class="py-5 bg-body-tertiary">
            <div class="container">
                <h2 class="mb-3">Вартість</h2>
                <p class="display-6">@tutor.HourlyRate.ToString("0.##") грн за годину</p>
            </div>
        </section>

        <section id="contacts" class="py-5">
            <div class="container">
                <h2 class="mb-3">Контакти</h2>
                <ul class="list-unstyled fs-5">
                    <li>Email: <a href="mailto:@tutor.Email">@tutor.Email</a></li>
                    @if (tutor.Phone is not null)
                    {
                        <li>Телефон: <a href="tel:@tutor.Phone">@tutor.Phone</a></li>
                    }
                </ul>
            </div>
        </section>
    </main>

    <footer class="border-top py-3">
        <div class="container text-body-secondary">&copy; 2026 TutorHub</div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
