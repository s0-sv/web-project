@model MaterialFormModel
@{
    ViewData["Title"] = "Редагування матеріалу";
}

<h1 class="h3 mb-3">Редагування матеріалу</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="col-lg-6">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a class="btn btn-link" asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.LessonId">Скасувати</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
