@model LessonFormModel
@{
    ViewData["Title"] = "Нове заняття";
}

<h1 class="h3 mb-3">Нове заняття</h1>
<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Створити</button>
    <a class="btn btn-link" asp-action="Index">Скасувати</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
