{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "extensions": {
    "queues": {
      "batchSize": 16,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:30",
      "maxPollingInterval": "00:00:05",
      "messageEncoding": "base64"
    }
  }
}
